FROM node:22-bookworm-slim

WORKDIR /app

# Compilacion desde la raiz del monorepo: npm workspaces comparte lockfile.
COPY . .
RUN npm ci --no-audit --no-fund

# Variables NEXT_PUBLIC_ quedan incorporadas al bundle en build time.
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CULQI_PUBLIC_KEY
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_CULQI_PUBLIC_KEY=${NEXT_PUBLIC_CULQI_PUBLIC_KEY}

RUN npm run build --workspace=@agrocloud/portal

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=@agrocloud/portal"]
