# URL pública real de la landing. Necesaria para metadatos, sitemap y robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# URL absoluta al login del portal, cuando esté accesible.
NEXT_PUBLIC_PORTAL_LOGIN_URL=http://localhost:3000/login

# El Gateway se consulta SOLO desde el servidor Next.js.
AGROCLOUD_GATEWAY_URL=http://localhost:4000

# Debe coincidir exactamente con la versión publicada en Identity.
IDENTITY_PRIVACY_VERSION=

# Mantener deshabilitado hasta publicar el aviso legal y validar todo el flujo.
# Para pruebas locales con datos ficticios puede habilitarse deliberadamente.
AGROCLOUD_PUBLIC_ONBOARDING_ENABLED=false
