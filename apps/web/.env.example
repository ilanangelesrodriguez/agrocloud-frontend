# URL pública de esta web. En producción usa el dominio HTTPS definitivo.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# URL COMPLETA del login del portal cuando realmente exista y funcione.
# Si no se configura, se oculta el botón para evitar enlaces rotos.
# NEXT_PUBLIC_PORTAL_LOGIN_URL=http://localhost:3000/login

# URL del Gateway SOLO para el servidor Next.js. Nunca NEXT_PUBLIC_.
# En local requiere el Gateway levantado en el puerto 4000.
AGROCLOUD_GATEWAY_URL=http://localhost:4000
# Ejemplo del Gateway desplegado (verifica que siga disponible):
# AGROCLOUD_GATEWAY_URL=https://agrocloud-gateway-png5gzcdaa-uc.a.run.app

# Misma versión del aviso publicado y configurado en Identity.
IDENTITY_PRIVACY_VERSION=
