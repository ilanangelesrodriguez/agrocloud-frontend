# Servidor Next.js => AgroCloud API Gateway (no exponer como NEXT_PUBLIC_)
AGROCLOUD_GATEWAY_URL=http://localhost:4000

# Generar: openssl rand -base64 32
# 32 bytes base64; mismo valor en todas las instancias. NO lo subas al repositorio.
AUTH_COOKIE_SECRET=

# Debe ser <= IDENTITY_REFRESH_DAYS (ms-identity); por defecto ambos 14.
AUTH_SESSION_MAX_AGE_DAYS=14

# Enlace público de la landing, utilizado solo en un enlace de navegación.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001/solicitar-acceso

NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_TU_LLAVE_PUBLICA

# Llave PUBLICA de Culqi Custom Checkout. Usar SOLO pk_test_... en esta etapa.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
