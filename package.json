{
  "name": "agrocloud-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@agrocloud/portal",
    "dev:portal": "turbo run dev --filter=@agrocloud/portal",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "npm run lint && npm run typecheck && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:portal": "prettier --write \"apps/portal/**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:portal:check": "prettier --check \"apps/portal/**/*.{ts,tsx,js,mjs,json,css,md}\""
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "prettier": "3.10.1"
  }
}